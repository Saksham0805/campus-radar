# These go in Vercel -> Project -> Settings -> Environment Variables
# (and in a local .env only if you use "vercel dev")

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/campusradar?retryWrites=true&w=majority
JWT_SECRET=any-long-random-gibberish
CRON_SECRET=another-long-random-gibberish

# ONE sender Gmail for your project (users log in with their own emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourprojectgmail@gmail.com
SMTP_PASS=your16letterapppassword
MAIL_FROM="Campus Radar <yourprojectgmail@gmail.com>"
